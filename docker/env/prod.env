DF_APP_NAME="Data-Forge Analysis Platform"
DF_APP_VERSION=1.0.0
DF_API_IMAGE=ghcr.io/volturine/data-forge-api:1.0.0
DF_SCHEDULER_IMAGE=ghcr.io/volturine/data-forge-scheduler:1.0.0
DF_WORKER_IMAGE=ghcr.io/volturine/data-forge-worker:1.0.0
DF_ENGINE_IMAGE=ghcr.io/volturine/data-forge-polars-engine@sha256:replace-with-published-engine-digest
DF_ENGINE_DOCKER_HOST=unix:///var/run/docker.sock
DF_ENGINE_DOCKER_NETWORK=dataforge-prod-engine-runtime
DF_ENGINE_RPC_PORT=50053
DF_ENGINE_START_TIMEOUT_SECONDS=30
DF_ENGINE_SHUTDOWN_GRACE_SECONDS=10
DF_ENGINE_HEARTBEAT_INTERVAL_SECONDS=5
DF_ENGINE_ALLOW_GLOBAL_OBJECT_STORE_CREDENTIALS=false
DF_ENGINE_OBJECT_STORE_CREDENTIALS_JSON=
DF_DEPLOYMENT_ID=dataforge-prod
DF_DOCKER_SOCKET_PATH=/var/run/docker.sock
DF_DOCKER_GID=0
DF_DEBUG=false
DF_PROD_MODE_ENABLED=true
DF_API_PORT=8000
DF_DATA_DIR=/app/data
DF_POSTGRES_DB=dataforge
DF_POSTGRES_USER=dataforge
DF_POSTGRES_PASSWORD=replace-with-strong-password
DF_DATABASE_URL=postgresql+psycopg://dataforge:replace-with-strong-password@postgres:5432/dataforge
DF_INTERNAL_API_TOKEN=replace-with-long-random-internal-runtime-token
DF_DATABASE_POOL_SIZE=10
DF_DATABASE_MAX_OVERFLOW=20
DF_DATABASE_POOL_TIMEOUT=30
DF_DEFAULT_NAMESPACE=default
DF_UPLOAD_CHUNK_SIZE=5242880
DF_OBJECT_STORE_ENDPOINT=http://rustfs:9000
DF_OBJECT_STORE_REGION=us-east-1
DF_OBJECT_STORE_ACCESS_KEY=replace-with-rustfs-access-key
DF_OBJECT_STORE_SECRET_KEY=replace-with-rustfs-secret-key
DF_POLARS_CORES_AVAILABLE=0
DF_POLARS_MAX_MEMORY_MB=0
DF_POLARS_STREAMING_CHUNK_SIZE=0
DF_MAX_CONCURRENT_ENGINES=10
DF_WORKERS=4
DF_WORKER_CONNECTIONS=1000
DF_BUILD_WORKER_MIN_PROCESSES=0
DF_BUILD_WORKER_MAX_PROCESSES=10
DF_BUILD_WORKER_IDLE_EXIT_SECONDS=30
DF_SCHEDULER_CHECK_INTERVAL=60
DF_LOG_LEVEL=info
DF_TRUSTED_PROXY_HOPS=0
DF_AUTH_REQUIRED=true
DF_VERIFY_EMAIL_ADDRESS=false
DF_DEFAULT_USER_EMAIL=admin@example.com
DF_DEFAULT_USER_PASSWORD=replace-with-strong-password
DF_DEFAULT_USER_NAME=Admin
DF_SETTINGS_ENCRYPTION_KEY=replace-with-long-random-secret
DF_AUTH_FRONTEND_URL=http://localhost:8000
DF_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DF_GOOGLE_CLIENT_ID=
DF_GOOGLE_CLIENT_SECRET=
DF_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
DF_GITHUB_CLIENT_ID=
DF_GITHUB_CLIENT_SECRET=
DF_GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
