# E2E test environment (compose variables + canonical test runtime)

# E2E test environment — used by `just test-e2e`
# Safe, self-contained config that avoids touching production data.
# Disable gRPC fork support to avoid macOS ev_poll_posix crash during e2e parallel execution.
GRPC_ENABLE_FORK_SUPPORT=0

ENV_FILE=e2e.env

APP_NAME="Data-Forge E2E"
APP_VERSION="0.0.0-e2e"
DEBUG=false
PORT=8001
FRONTEND_PORT=3001
VITE_BACKEND_PORT=8001
INTERNAL_API_TOKEN=dataforge-e2e-internal-token
INTERNAL_GRPC_HOST=127.0.0.1
INTERNAL_GRPC_PORT=50052
INTERNAL_GRPC_TARGET=127.0.0.1:50052
WORKER_DATA_PLANE_GRPC_HOST=127.0.0.1
WORKER_DATA_PLANE_GRPC_PORT=50053
WORKER_DATA_PLANE_GRPC_TARGET=127.0.0.1:50053
E2E_PYTHON_VERSION=3.14
E2E_TIMEOUT_SECONDS=${E2E_TIMEOUT_SECONDS:-1620}
E2E_TIMEOUT_GRACE_SECONDS=${E2E_TIMEOUT_GRACE_SECONDS:-30}
PW_E2E_WORKERS=${PW_E2E_WORKERS:-4}

CORS_ORIGINS="http://localhost:3001,http://127.0.0.1:3001"
AUTH_FRONTEND_URL="http://localhost:3001"

DATA_DIR=/tmp/polars-fastapi-svelte-e2e
DATABASE_URL=postgresql+psycopg://dataforge:dataforge@127.0.0.1:55432/dataforge
DEFAULT_NAMESPACE=default
DATABASE_POOL_SIZE=64
DATABASE_MAX_OVERFLOW=32
DATABASE_POOL_TIMEOUT=30
OBJECT_STORE_ENDPOINT=http://127.0.0.1:59000
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY=dataforge-e2e-access
OBJECT_STORE_SECRET_KEY=dataforge-e2e-secret
BUILD_WORKER_MIN_PROCESSES=${BUILD_WORKER_MIN_PROCESSES:-4}
BUILD_WORKER_MAX_PROCESSES=${BUILD_WORKER_MAX_PROCESSES:-4}
BUILD_WORKER_IDLE_EXIT_SECONDS=60
SCHEDULER_CHECK_INTERVAL=1

UPLOAD_CHUNK_SIZE=5242880

POLARS_CORES_AVAILABLE=1
# EngineResourceConfig's supported nonzero minimum.
POLARS_MAX_MEMORY_MB=${POLARS_MAX_MEMORY_MB:-256}
POLARS_STREAMING_CHUNK_SIZE=0
# Cap live engines; excess engine work queues until capacity is available.
MAX_CONCURRENT_ENGINES=${MAX_CONCURRENT_ENGINES:-8}

WORKERS=1
WORKER_CONNECTIONS=100
COMPUTE_REQUEST_CONCURRENCY=${COMPUTE_REQUEST_CONCURRENCY:-4}
LOG_LEVEL=${LOG_LEVEL:-warning}
UVICORN_ACCESS_LOG=false
LOG_QUEUE_OVERFLOW=drop
LOG_MAX_BODY_SIZE=0
PERSIST_PREVIEW_RUNS=true

PROD_MODE_ENABLED=false

TIMEZONE=UTC
NORMALIZE_TZ=false

AUTH_REQUIRED=true
VERIFY_EMAIL_ADDRESS=false
SETTINGS_ENCRYPTION_KEY=e2e-test-key-not-for-production
DEFAULT_USER_EMAIL=default@example.com
DEFAULT_USER_PASSWORD=ChangeMe123
DEFAULT_USER_NAME="Default User"
