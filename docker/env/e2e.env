# E2E test environment — sourced by scripts/test_e2e.sh. Values are exported
# into the shell and interpolated into docker/compose.e2e.yaml, which runs the
# whole stack as containers on one private Docker network. Services and
# Playwright runners reach each other by container DNS name.

APP_NAME="Data-Forge E2E"
APP_VERSION="0.0.0-e2e"
DEBUG=false

INTERNAL_API_TOKEN=dataforge-e2e-internal-token
INTERNAL_GRPC_PORT=50051
RUNTIME_COORDINATOR_TARGET=runtime:50051
WORKER_DATA_PLANE_GRPC_PORT=50052

# Keep the regular browser suite at two workers per shard; the 50-tab probe
# runs afterward in its own bounded Chromium process pool.
PW_E2E_WORKERS=${PW_E2E_WORKERS:-2}
E2E_SHARDS=${E2E_SHARDS:-3}
E2E_TIMEOUT_SECONDS=${E2E_TIMEOUT_SECONDS:-1500}
E2E_TIMEOUT_GRACE_SECONDS=${E2E_TIMEOUT_GRACE_SECONDS:-30}
E2E_FIXTURE_BOOTSTRAP_TIMEOUT_SECONDS=${E2E_FIXTURE_BOOTSTRAP_TIMEOUT_SECONDS:-600}
E2E_ENGINE_START_TIMEOUT_SECONDS=${E2E_ENGINE_START_TIMEOUT_SECONDS:-120}
# Match the service's idle lifetime so multi-step E2E interactions do not
# create artificial worker shutdown/restart churn. Stack teardown removes all
# run-owned containers after the suite.
E2E_ENGINE_IDLE_TTL_SECONDS=${E2E_ENGINE_IDLE_TTL_SECONDS:-300}
E2E_ENGINE_IDLE_REAP_INTERVAL_SECONDS=${E2E_ENGINE_IDLE_REAP_INTERVAL_SECONDS:-30}

CORS_ORIGINS="http://api:8000"
AUTH_FRONTEND_URL="http://api:8000"

DATABASE_URL=postgresql+psycopg://dataforge:dataforge@postgres:5432/dataforge
DEFAULT_NAMESPACE=default
# Pool values are per process and SQLAlchemy engine. API processes and the
# coordinator inherit the same bounded pool; compute-worker capacity does not
# increase PostgreSQL connections.
DATABASE_POOL_SIZE=${DATABASE_POOL_SIZE:-8}
DATABASE_MAX_OVERFLOW=${DATABASE_MAX_OVERFLOW:-4}
DATABASE_POOL_TIMEOUT=30
OBJECT_STORE_ENDPOINT=http://rustfs:9000
OBJECT_STORE_REGION=us-east-1
OBJECT_STORE_ACCESS_KEY=dataforge-e2e-access
OBJECT_STORE_SECRET_KEY=dataforge-e2e-secret
# The 50-tab probe has 30 distinct analysis identities and one shared
# datasource identity; tabs on the same identity share its worker/cache.
COMPUTE_WORKERS=${COMPUTE_WORKERS:-14}
SCHEDULER_CHECK_INTERVAL=1


POLARS_CORES_AVAILABLE=1
# Keep the engine memory bound fixed so queueing and engine failures remain
# reproducible across E2E runner hosts.
POLARS_MAX_MEMORY_MB=${POLARS_MAX_MEMORY_MB:-256}
POLARS_STREAMING_CHUNK_SIZE=0
# Keep two unassigned workers ready for the analysis burst. They are the same
# worker type and are replaced immediately when assigned to an identity.
COMPUTE_WARM_WORKERS=${COMPUTE_WARM_WORKERS:-2}

# Exercise stateless API multiprocessing against the dedicated coordinator.
WORKERS=${E2E_API_WORKERS:-${WORKERS:-4}}
WORKER_CONNECTIONS=4096
# The 50-browser probe is part of every full E2E run. Queued work remains
# durable while the shared worker budget controls active execution and identity.
E2E_CONCURRENCY_BROWSERS=${E2E_CONCURRENCY_BROWSERS:-50}
# One budget controls active compute work and assigned workers.
LOG_LEVEL=${LOG_LEVEL:-warning}
# Avoid per-request DB writes and access-log volume under load; Playwright traces
# capture requests while API warnings retain timings and backend diagnostics.
UVICORN_ACCESS_LOG=false
LOG_QUEUE_OVERFLOW=drop
LOG_REQUESTS_ENABLED=${LOG_REQUESTS_ENABLED:-false}
# Keep request diagnostics bounded; frontend assets are excluded by the
# middleware, and API payloads above this limit are still served normally.
LOG_MAX_BODY_SIZE=65536
PERSIST_PREVIEW_RUNS=true

TIMEZONE=UTC
NORMALIZE_TZ=false

AUTH_REQUIRED=true
VERIFY_EMAIL_ADDRESS=false
# Prod mode rejects the placeholder default password; e2e never logs in as the
# default user anyway — tests register their own users.
DEFAULT_USER_EMAIL=default@example.com
DEFAULT_USER_PASSWORD=E2eDefaultPw9x7
DEFAULT_USER_NAME="Default User"
SETTINGS_ENCRYPTION_KEY=e2e-test-key-not-for-production
