ARG PYTHON_VERSION=3.14.6
ARG BUN_VERSION=1.3.11
ARG UV_VERSION=0.10.4
ARG JUST_VERSION=1.51.0

FROM oven/bun:${BUN_VERSION} AS bun
FROM node:24-slim AS node-runtime
FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv
FROM docker:29.7.2-cli AS docker-cli

FROM python:${PYTHON_VERSION}-slim-trixie
ARG JUST_VERSION
ENV DEBIAN_FRONTEND=noninteractive \
    UV_LINK_MODE=copy \
    UV_CACHE_DIR=/root/.cache/uv

COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
COPY --from=node-runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=uv /uv /usr/local/bin/uv
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/ /usr/local/libexec/docker/cli-plugins/

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash build-essential ca-certificates curl iproute2 procps ripgrep \
    && rm -rf /var/lib/apt/lists/* \
    && case "$(dpkg --print-architecture)" in \
        amd64) just_arch=x86_64-unknown-linux-musl ;; \
        arm64) just_arch=aarch64-unknown-linux-musl ;; \
        *) echo "Unsupported architecture: $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://github.com/casey/just/releases/download/${JUST_VERSION}/just-${JUST_VERSION}-${just_arch}.tar.gz" \
        | tar -xz -C /usr/local/bin just

WORKDIR /app
COPY packages/protocol/package.json packages/protocol/bun.lock /app/packages/protocol/
COPY packages/frontend/package.json packages/frontend/bun.lock /app/packages/frontend/
RUN cd packages/protocol && bun install --frozen-lockfile --ignore-scripts \
    && cd /app/packages/frontend && bun install --frozen-lockfile --ignore-scripts

COPY packages/protocol/pyproject.toml packages/protocol/uv.lock /app/packages/protocol/
COPY packages/backend/pyproject.toml packages/backend/uv.lock /app/packages/backend/
COPY packages/scheduler/pyproject.toml packages/scheduler/uv.lock /app/packages/scheduler/
COPY packages/worker/pyproject.toml packages/worker/uv.lock /app/packages/worker/
RUN cd /app/packages/protocol && uv sync --locked --all-groups --no-install-project \
    && cd /app/packages/backend && uv sync --locked --all-groups --no-install-project \
    && cd /app/packages/scheduler && uv sync --locked --all-groups --no-install-project \
    && cd /app/packages/worker && uv sync --locked --all-groups --no-install-project \
    && rm -rf /root/.cache/uv

COPY . /app
RUN just generate-protocol \
    && cd /app/packages/frontend && bun install --frozen-lockfile \
    && cd /app/packages/backend && uv sync --locked --all-groups \
    && cd /app/packages/scheduler && uv sync --locked --all-groups \
    && cd /app/packages/worker && uv sync --locked --all-groups

ENV PATH="/app/packages/backend/.venv/bin:/app/packages/scheduler/.venv/bin:/app/packages/worker/.venv/bin:/app/packages/frontend/node_modules/.bin:/app/packages/protocol/node_modules/.bin:${PATH}"

CMD ["scripts/test_inside.sh"]
