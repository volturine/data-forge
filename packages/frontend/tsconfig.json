{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"paths": { "#lib/*": ["./src/lib/*"] },
		"types": ["$app/types", "node"],
		"rewriteRelativeImportExtensions": true,
		"sourceMap": true,
		"strict": true
	},
	"exclude": ["node_modules/**", "tests/.artifacts/**"],
	"include": ["src", "vite.config.ts", "playwright.config.ts", "tests"]
}
