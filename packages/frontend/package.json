{
	"name": "frontend",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"scripts": {
		"predev": "svelte-kit sync && panda codegen && panda cssgen",
		"dev": "vite dev",
		"build": "svelte-kit sync && panda cssgen && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && panda codegen && panda cssgen || echo ''",
		"panda:codegen": "svelte-kit sync && panda codegen",
		"panda:watch": "panda codegen --watch",
		"check": "svelte-kit sync && rm -rf .svelte-kit/.svelte-check && svelte-check --tsgo --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && rm -rf .svelte-kit/.svelte-check && svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"generate:protocol": "cd ../.. && just generate-protocol",
		"test:e2e": "playwright test --config=playwright.config.ts",
		"test:e2e:ui": "playwright test --config=playwright.config.ts --ui",
		"test:e2e:report": "playwright show-report tests/.artifacts/playwright/playwright-report",
		"test:unit": "node ./node_modules/vitest/vitest.mjs run",
		"test:unit:watch": "node ./node_modules/vitest/vitest.mjs"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@pandacss/dev": "^2.1.2",
		"@pandacss/preset-base": "^2.1.2",
		"@pandacss/preset-panda": "^2.1.2",
		"@playwright/test": "^1.64.0",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.1",
		"@sveltejs/load-config": "^0.2.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.4.2",
		"@types/d3-scale": "^4.0.9",
		"@types/d3-scale-chromatic": "^3.1.0",
		"@types/d3-shape": "^3.2.0",
		"@types/node": "^26.6.5",
		"@typescript/native": "npm:typescript@~7.0.2",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"jsdom": "^30.1.2",
		"prettier": "^3.9.9",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.6",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.1",
		"vite": "^8.3.4",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@bufbuild/protobuf": "^2.16.0",
		"@codemirror/lang-python": "^6.2.1",
		"@codemirror/language": "6.13.1",
		"@lezer/highlight": "1.2.5",
		"@lucide/svelte": "^1.54.0",
		"@tanstack/charts": "1.1.0",
		"@tanstack/svelte-query": "6.3.1",
		"@tanstack/svelte-table": "^9.2.8",
		"@xyflow/svelte": "^1.7.0",
		"codemirror": "^6.0.2",
		"d3-scale": "^4.0.2",
		"d3-scale-chromatic": "^3.1.0",
		"d3-shape": "^3.2.0",
		"dompurify": "^3.4.16",
		"elkjs": "^0.12.0",
		"marked": "^18.1.0",
		"neverthrow": "^8.2.0",
		"runed": "^0.37.1",
		"temporal-polyfill": "^1.0.5"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
